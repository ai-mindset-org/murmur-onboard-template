# murmur-onboard-template — per-user configuration
# Copy to .env, fill in YOUR values. Never commit .env.
#
# Each AIM team member runs THEIR OWN copy of this stack on THEIR Mac.
# No central server. No shared identity. Personal context only.

# === AGENT IDENTITY ===
# Short uppercase tag for your agent persona (e.g. SHAPER, CTRL, ATELIER).
# Used in murmur sign-in and in display names on the team mesh.
AGENT_NAME=SHAPER

# Your operator first/last name as seen by other agents until you rename
# the murmur identity to AGENT_NAME-only. Optional — can leave empty
# if you already signed-in with first-name=AGENT_NAME.
OPERATOR_FIRST_NAME=Alexander
OPERATOR_LAST_NAME=Povaliaev

# === MURMUR PEER IDs ===
# 44-char base64 IDs of the peers your bridge forwards from.
# Each entry = one base64 ID. Multiple = comma-separated.
# Get peer IDs from your teammates via `murmur me` then trade them
# over a secure channel (Linear DM, 1Password share, in-person).
MURMUR_PEER_IDS=786e3asEZd4oZ5XLPUTzDBKHHteLexXxw7QRyxWMJNed

# === TELEGRAM BOT ===
# Create a bot via @BotFather on Telegram. Send /newbot, get token.
# Then add the bot as admin to your personal notifications channel
# (e.g. @notify_yourname). The channel must be PUBLIC or you must
# use its private numeric chat_id (e.g. -1002153831465).
MURMUR_BRIDGE_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN
MURMUR_BRIDGE_CHANNEL=@notify_yourname

# === LOCAL PORTS ===
# Bridge HTTP listener (must match plist + webhook URL).
# Pick a free port. Default 18790. Check via `lsof -i :18790`.
BRIDGE_PORT=18790

# === OPTIONAL — clawdbot wake hook ===
# If you run clawdbot-gateway, set this to its wake endpoint so the
# bridge also wakes your Claude Code session when a peer message arrives.
# Leave empty to disable.
CLAWDBOT_WAKE_URL=

# === PATHS (rarely changed) ===
MURMUR_BIN=/opt/homebrew/bin/murmur
STATE_DIR=${HOME}/.config/murmur-bridge
LOG_DIR=${HOME}/Library/Logs

# === HEARTBEAT ===
# Interval in seconds for periodic status pings to your Telegram channel.
# Default 1800 (30 min). Set to 3600 for hourly, 0 to disable.
HEARTBEAT_INTERVAL=1800
